# ==========================================
# EarlyJobs.ai Mini ATS — Environment Variables
# ==========================================

# 1. MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/earlyjobs_mini_ats?retryWrites=true&w=majority

# 2. NextAuth.js / Auth.js Secret
# Generate with: openssl rand -base64 32 or npx auth secret
AUTH_SECRET=your_nextauth_secret_key_here_min_32_chars_long

# 3. Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. Google OAuth 2.0 Credentials
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (and your Vercel domain in production)
AUTH_GOOGLE_ID=your_google_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_client_secret

# 5. GitHub OAuth Credentials (Optional)
# Create at: https://github.com/settings/developers
# Authorized callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=your_github_client_id
AUTH_GITHUB_SECRET=your_github_client_secret

# 6. Admin Provisioning Key (Optional secure seeding / admin setup)
ADMIN_PROVISION_SECRET=ats_admin_bootstrap_secret_change_me_in_production
